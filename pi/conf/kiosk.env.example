# /etc/roundremote/kiosk.env — Round Remote kiosk settings (read by pi/kiosk.sh and roundremote-kiosk.service).
# After editing:  sudo systemctl restart roundremote-kiosk
ROUNDREMOTE_URL=http://127.0.0.1:8765/
# ROUNDREMOTE_PROFILE="Living room"
# ROUNDREMOTE_COMPOSITOR=cage          # or labwc
# ROUNDREMOTE_OUTPUT=HDMI-A-1
# ROUNDREMOTE_TRANSFORM=normal         # 90 | 180 | 270 — turns the whole screen and touch
# ROUNDREMOTE_MODE=720x720
# ROUNDREMOTE_CURSOR=auto              # auto (hidden unless a mouse is plugged in) | hide | show
# ROUNDREMOTE_BOOT_PAGE=1              # 0 = no logo page while the bridge starts (black instead)
# CHROMIUM_FLAGS="--renderer-process-limit=2"
