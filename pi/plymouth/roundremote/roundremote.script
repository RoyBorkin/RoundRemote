// Round Remote boot splash (Plymouth "script" theme).
// Black screen, the logo in the middle fading in and then breathing softly, and a thin ring that fills clockwise
// from 12 o'clock as the boot goes on (Plymouth's boot progress). At shutdown / reboot a short arc circles instead.
// The geometry matches the app's startup animation (index.html #rr-splash and pi/boot.html), so the hand-over
// Plymouth → Chromium → app keeps the logo in the same place: a 720×720 frame centred on the screen and scaled to its
// short side, the logo in a 288 px box, the ring at radius 295.2 px, 4 px wide.
// Images and the offset table below: pi/plymouth/make-theme.py. Installed by pi/install.sh.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
S = Math.Min(W, H) / 720;
CX = Window.GetX() + Math.Int(W / 2);
CY = Window.GetY() + Math.Int(H / 2);
N = 90;            // ring pieces (4° each)
FADE = 40;         // frames to fade in (Plymouth calls refresh up to 50 times a second)

// >>> generated by make-theme.py (segment image offsets from the centre, at 720 px)
seg_x[0] = -6; seg_y[0] = -312; seg_x[1] = 14; seg_y[1] = -310; seg_x[2] = 35; seg_y[2] = -307;
seg_x[3] = 55; seg_y[3] = -303; seg_x[4] = 75; seg_y[4] = -297; seg_x[5] = 94; seg_y[5] = -290;
seg_x[6] = 113; seg_y[6] = -282; seg_x[7] = 131; seg_y[7] = -272; seg_x[8] = 149; seg_y[8] = -261;
seg_x[9] = 165; seg_y[9] = -249; seg_x[10] = 181; seg_y[10] = -236; seg_x[11] = 196; seg_y[11] = -222;
seg_x[12] = 210; seg_y[12] = -206; seg_x[13] = 222; seg_y[13] = -190; seg_x[14] = 234; seg_y[14] = -173;
seg_x[15] = 244; seg_y[15] = -155; seg_x[16] = 253; seg_y[16] = -137; seg_x[17] = 261; seg_y[17] = -117;
seg_x[18] = 267; seg_y[18] = -98; seg_x[19] = 272; seg_y[19] = -78; seg_x[20] = 276; seg_y[20] = -58;
seg_x[21] = 278; seg_y[21] = -37; seg_x[22] = 279; seg_y[22] = -17; seg_x[23] = 278; seg_y[23] = 4;
seg_x[24] = 276; seg_y[24] = 25; seg_x[25] = 272; seg_y[25] = 45; seg_x[26] = 267; seg_y[26] = 65;
seg_x[27] = 261; seg_y[27] = 84; seg_x[28] = 253; seg_y[28] = 104; seg_x[29] = 244; seg_y[29] = 122;
seg_x[30] = 234; seg_y[30] = 140; seg_x[31] = 222; seg_y[31] = 157; seg_x[32] = 210; seg_y[32] = 173;
seg_x[33] = 196; seg_y[33] = 189; seg_x[34] = 181; seg_y[34] = 203; seg_x[35] = 165; seg_y[35] = 216;
seg_x[36] = 149; seg_y[36] = 228; seg_x[37] = 131; seg_y[37] = 239; seg_x[38] = 113; seg_y[38] = 249;
seg_x[39] = 94; seg_y[39] = 257; seg_x[40] = 75; seg_y[40] = 264; seg_x[41] = 55; seg_y[41] = 270;
seg_x[42] = 35; seg_y[42] = 274; seg_x[43] = 14; seg_y[43] = 277; seg_x[44] = -6; seg_y[44] = 279;
seg_x[45] = -27; seg_y[45] = 279; seg_x[46] = -47; seg_y[46] = 277; seg_x[47] = -68; seg_y[47] = 274;
seg_x[48] = -88; seg_y[48] = 270; seg_x[49] = -108; seg_y[49] = 264; seg_x[50] = -127; seg_y[50] = 257;
seg_x[51] = -146; seg_y[51] = 249; seg_x[52] = -164; seg_y[52] = 239; seg_x[53] = -182; seg_y[53] = 228;
seg_x[54] = -198; seg_y[54] = 216; seg_x[55] = -214; seg_y[55] = 203; seg_x[56] = -229; seg_y[56] = 189;
seg_x[57] = -243; seg_y[57] = 173; seg_x[58] = -255; seg_y[58] = 157; seg_x[59] = -267; seg_y[59] = 140;
seg_x[60] = -277; seg_y[60] = 122; seg_x[61] = -286; seg_y[61] = 104; seg_x[62] = -294; seg_y[62] = 84;
seg_x[63] = -300; seg_y[63] = 65; seg_x[64] = -305; seg_y[64] = 45; seg_x[65] = -309; seg_y[65] = 25;
seg_x[66] = -311; seg_y[66] = 4; seg_x[67] = -312; seg_y[67] = -16; seg_x[68] = -311; seg_y[68] = -37;
seg_x[69] = -309; seg_y[69] = -58; seg_x[70] = -305; seg_y[70] = -78; seg_x[71] = -300; seg_y[71] = -98;
seg_x[72] = -294; seg_y[72] = -117; seg_x[73] = -286; seg_y[73] = -137; seg_x[74] = -277; seg_y[74] = -155;
seg_x[75] = -267; seg_y[75] = -173; seg_x[76] = -255; seg_y[76] = -190; seg_x[77] = -243; seg_y[77] = -206;
seg_x[78] = -229; seg_y[78] = -222; seg_x[79] = -214; seg_y[79] = -236; seg_x[80] = -198; seg_y[80] = -249;
seg_x[81] = -182; seg_y[81] = -261; seg_x[82] = -164; seg_y[82] = -272; seg_x[83] = -146; seg_y[83] = -282;
seg_x[84] = -127; seg_y[84] = -290; seg_x[85] = -108; seg_y[85] = -297; seg_x[86] = -88; seg_y[86] = -303;
seg_x[87] = -68; seg_y[87] = -307; seg_x[88] = -47; seg_y[88] = -310; seg_x[89] = -27; seg_y[89] = -312;
// <<< generated

digit[0] = "0"; digit[1] = "1"; digit[2] = "2"; digit[3] = "3"; digit[4] = "4";
digit[5] = "5"; digit[6] = "6"; digit[7] = "7"; digit[8] = "8"; digit[9] = "9";

fun seg_name(i) {
  return "seg-" + digit[Math.Int(i / 10)] + digit[i % 10] + ".png";
}

fun scaled(img) {
  if (S == 1) {
    return img;
  }
  return img.Scale(Math.Int(img.GetWidth() * S + 0.5), Math.Int(img.GetHeight() * S + 0.5));
}

fun centred(sprite, img, z) {
  sprite.SetPosition(CX - Math.Int(img.GetWidth() / 2), CY - Math.Int(img.GetHeight() / 2), z);
}

track_img = scaled(Image("track.png"));
track = Sprite(track_img);
centred(track, track_img, 5);
track.SetOpacity(0);

for (i = 0; i < N; i++) {
  seg[i] = Sprite(scaled(Image(seg_name(i))));
  seg[i].SetPosition(CX + Math.Int(seg_x[i] * S), CY + Math.Int(seg_y[i] * S), 6);
  seg[i].SetOpacity(0);
}

logo_img = scaled(Image("logo.png"));
logo = Sprite(logo_img);
centred(logo, logo_img, 10);
logo.SetOpacity(0);

msg = Sprite();
msg.SetPosition(CX, CY + Math.Int(215 * S), 20);

mode = Plymouth.GetMode();
spin = 0;
if (mode == "shutdown" || mode == "reboot") {
  spin = 1;
}

t = 0;          // frames since the start
target = 0;     // the boot progress Plymouth reports (0…1)
shown = 0;      // the progress the ring shows (eases towards target, never goes back)
lit = 0;        // ring pieces fully on

fun boot_frame(fade) {
  if (target > shown) {
    global.shown = Math.Min(target, shown + Math.Max((target - shown) * 0.08, 0.002));
  }
  n = shown * N;
  full = Math.Min(Math.Int(n), N);
  if (t <= FADE) {
    for (i = 0; i < lit; i++) {
      seg[i].SetOpacity(fade);
    }
  }
  while (lit < full) {
    seg[lit].SetOpacity(fade);
    global.lit = lit + 1;
  }
  if (full < N) {
    seg[full].SetOpacity((n - full) * fade);
  }
}

fun spin_frame(fade) {
  head = t % N;
  for (k = 0; k < 16; k++) {
    seg[(head - k + N) % N].SetOpacity((1 - k / 16) * fade);
  }
  seg[(head - 16 + N) % N].SetOpacity(0);
}

fun refresh() {
  global.t = t + 1;
  fade = Math.Min(t / FADE, 1);
  if (t > FADE) {
    logo.SetOpacity(0.93 + 0.07 * Math.Cos((t - FADE) * 2 * Math.Pi / 150));
  } else {
    logo.SetOpacity(fade);
  }
  track.SetOpacity(fade);
  if (spin) {
    spin_frame(fade);
  } else {
    boot_frame(fade);
  }
}

fun boot_progress(duration, progress) {
  global.target = Math.Clamp(progress, 0, 1);
}

// the last frame stays on screen (plymouth quit --retain-splash) until the kiosk draws: show it complete
fun quit() {
  logo.SetOpacity(1);
  track.SetOpacity(1);
  for (i = 0; i < N; i++) {
    seg[i].SetOpacity(1);
  }
}

fun message(text) {
  img = Image.Text(text, 0.75, 0.75, 0.75);
  if (img) {
    msg.SetImage(img);
    msg.SetX(CX - Math.Int(img.GetWidth() / 2));
    msg.SetOpacity(1);
  }
}

fun display_password(prompt, bullets) {
  s = prompt + "  ";
  for (i = 0; i < bullets; i++) {
    s = s + "*";
  }
  message(s);
}

fun display_question(prompt, entry) {
  message(prompt + "  " + entry);
}

fun display_normal() {
  msg.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetQuitFunction(quit);
Plymouth.SetMessageFunction(message);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayNormalFunction(display_normal);
