# Round Remote kiosk on the round screen: a Wayland compositor (cage, or labwc) + Chromium, on tty1, logged in
# as __USER__ without a desktop (Raspberry Pi OS Lite). Based on cage's "Starting Cage on boot with systemd".
# Installed by pi/install.sh; settings in /etc/roundremote/kiosk.env.
[Unit]
Description=Round Remote kiosk (cage + Chromium) on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service roundremote-bridge.service
Wants=roundremote-bridge.service
ConditionPathExists=/dev/tty1
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-/etc/roundremote/kiosk.env
ExecStart=__APP_DIR__/pi/kiosk.sh
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
PAMName=roundremote-kiosk

[Install]
WantedBy=multi-user.target
